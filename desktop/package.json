{
  "name": "tradezoro-desktop",
  "productName": "TradeZoro",
  "version": "2.0.1",
  "description": "TradeZoro for Windows, macOS and Linux: the tradezoro.com app in its own window, with pop-out charts, always-on-top and native notifications.",
  "author": "TradeZoro LLC",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/policy.test.js test/handoff.test.js test/updates.test.js test/shown.test.js test/core.test.js",
    "dist:win": "electron-builder --win nsis portable --x64",
    "dist:linux": "electron-builder --linux AppImage deb --x64",
    "dist:appx": "electron-builder --win appx --x64",
    "dist:mac": "electron-builder --mac dmg zip --arm64 --x64"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.tradezoro.desktop",
    "productName": "TradeZoro",
    "copyright": "© 2026 TradeZoro LLC",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "protocols": [
      {
        "name": "TradeZoro sign-in",
        "schemes": [
          "tradezoro"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "theelitegrey",
        "repo": "Stryker-trading-academy-",
        "tagNamePrefix": "desktop-v",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "executableName": "TradeZoro",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "TradeZoro-Setup.exe",
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "TradeZoro",
      "uninstallDisplayName": "TradeZoro",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "TradeZoro-Portable.exe"
    },
    "appx": {
      "artifactName": "TradeZoro.appx",
      "identityName": "TradeZoro.Desktop",
      "publisher": "CN=TradeZoro LLC",
      "publisherDisplayName": "TradeZoro LLC",
      "displayName": "TradeZoro",
      "applicationId": "TradeZoro",
      "backgroundColor": "#050506",
      "languages": [
        "en-US"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "executableName": "tradezoro",
      "category": "Office",
      "maintainer": "TradeZoro LLC <support@tradezoro.com>",
      "synopsis": "TradeZoro desktop app",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "TradeZoro-linux-x64.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.finance",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "TradeZoro-mac-${arch}.${ext}",
      "minimumSystemVersion": "11.0"
    },
    "dmg": {
      "title": "TradeZoro",
      "sign": false
    }
  },
  "homepage": "https://tradezoro.com"
}
