//@version=5
indicator("Map and matrix stats (sample)")
var map<int, float> hourVol = map.new<int, float>()
var map<int, int> hourCnt = map.new<int, int>()
h = hour(time)
hourVol.put(h, nz(hourVol.get(h)) + volume)
hourCnt.put(h, nz(hourCnt.get(h)) + 1)
avgVol = hourVol.get(h) / hourCnt.get(h)
var matrix<float> m = matrix.new<float>(20, 3, 0.0)
m.add_row(0, array.from(close, high - low, volume))
m.remove_row(m.rows() - 1)
rangeAvg = array.avg(m.col(1))
cov = array.covariance(m.col(0), m.col(2))
plot(volume / avgVol, "Rel. hour volume", color=color.blue, style=plot.style_columns)
plot(rangeAvg, "Avg range 20", color=color.orange)
hline(1, "1x")
