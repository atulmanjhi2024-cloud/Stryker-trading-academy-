//@version=5
indicator("FVG boxes + swing lines (sample)", overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500)
showBoxes = input.bool(true, "Show FVGs")
extendN = input.int(20, "Extend bars")
var box[] fvgs = array.new_box()
bull = low > high[2] and close[1] > open[1]
bear = high < low[2] and close[1] < open[1]
if showBoxes and bull
    array.push(fvgs, box.new(bar_index - 2, low, bar_index + extendN, high[2], bgcolor=color.new(color.green, 80), border_color=color.green))
if showBoxes and bear
    array.push(fvgs, box.new(bar_index - 2, low[2], bar_index + extendN, high, bgcolor=color.new(color.red, 80), border_color=color.red))
if array.size(fvgs) > 400
    box.delete(array.shift(fvgs))
// mitigate
if array.size(fvgs) > 0
    for i = array.size(fvgs) - 1 to 0
        b = array.get(fvgs, i)
        if close < box.get_bottom(b) and close > box.get_top(b) - 1e9 and high > box.get_top(b) and low < box.get_bottom(b)
            box.set_bgcolor(b, color.new(color.gray, 90))
sh = ta.pivothigh(high, 3, 3)
sl = ta.pivotlow(low, 3, 3)
if not na(sh)
    line.new(bar_index - 3, sh, bar_index + 10, sh, color=color.red, style=line.style_dashed)
if not na(sl)
    line.new(bar_index - 3, sl, bar_index + 10, sl, color=color.green, style=line.style_dashed)
