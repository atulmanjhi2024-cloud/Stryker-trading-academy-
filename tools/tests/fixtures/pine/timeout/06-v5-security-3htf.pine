//@version=5
indicator("MTF trend dashboard (sample)", overlay=true)
tf1 = input.timeframe("15", "TF 1")
tf2 = input.timeframe("60", "TF 2")
tf3 = input.timeframe("240", "TF 3")
emaF(src) => ta.ema(src, 50)
e1 = request.security(syminfo.tickerid, tf1, emaF(close))
e2 = request.security(syminfo.tickerid, tf2, emaF(close))
e3 = request.security(syminfo.tickerid, tf3, emaF(close))
[h1, l1] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)
plot(e1, "EMA50 " + tf1, color=color.aqua)
plot(e2, "EMA50 " + tf2, color=color.orange)
plot(e3, "EMA50 " + tf3, color=color.fuchsia)
plot(h1, "PDH", color=color.green, style=plot.style_stepline)
plot(l1, "PDL", color=color.red, style=plot.style_stepline)
var table t = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 20))
if barstate.islast
    table.cell(t, 0, 0, "TF", text_color=color.white)
    table.cell(t, 1, 0, "Trend", text_color=color.white)
    table.cell(t, 0, 1, tf1, text_color=color.white)
    table.cell(t, 1, 1, close > e1 ? "Up" : "Down", text_color=close > e1 ? color.green : color.red)
    table.cell(t, 0, 2, tf2, text_color=color.white)
    table.cell(t, 1, 2, close > e2 ? "Up" : "Down", text_color=close > e2 ? color.green : color.red)
    table.cell(t, 0, 3, tf3, text_color=color.white)
    table.cell(t, 1, 3, close > e3 ? "Up" : "Down", text_color=close > e3 ? color.green : color.red)
