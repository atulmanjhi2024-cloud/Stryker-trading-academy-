//@version=5
strategy("EMA cross strategy (sample)", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, pyramiding=0)
fast = input.int(9, "Fast")
slow = input.int(21, "Slow")
f = ta.ema(close, fast)
s = ta.ema(close, slow)
atr = ta.atr(14)
if ta.crossover(f, s)
    strategy.entry("L", strategy.long)
if ta.crossunder(f, s)
    strategy.entry("S", strategy.short)
strategy.exit("XL", "L", stop=close - 2 * atr, limit=close + 3 * atr)
strategy.exit("XS", "S", stop=close + 2 * atr, limit=close - 3 * atr)
plot(f, "Fast", color=color.teal)
plot(s, "Slow", color=color.orange)
