//@version=6
indicator("v6 regression channel loop (sample)", overlay=true, max_lines_count=10)
int n = input.int(800, "Window", minval=50, maxval=3000)
float devMult = input.float(2.0, "Deviation")
var line mid = na
var line up = na
var line dn = na
if barstate.islast
    int w = math.min(n, bar_index)
    float sx = 0.0, sy = 0.0, sxy = 0.0, sxx = 0.0
    for i = 0 to w - 1
        sx += i
        sy += close[i]
        sxy += i * close[i]
        sxx += i * i
    float slope = (w * sxy - sx * sy) / (w * sxx - sx * sx)
    float icpt = (sy - slope * sx) / w
    float se = 0.0
    for i = 0 to w - 1
        se += math.pow(close[i] - (icpt + slope * i), 2)
    float sd = math.sqrt(se / w)
    line.delete(mid), line.delete(up), line.delete(dn)
    mid := line.new(bar_index - w + 1, icpt + slope * (w - 1), bar_index, icpt, color=color.gray)
    up := line.new(bar_index - w + 1, icpt + slope * (w - 1) + devMult * sd, bar_index, icpt + devMult * sd, color=color.red)
    dn := line.new(bar_index - w + 1, icpt + slope * (w - 1) - devMult * sd, bar_index, icpt - devMult * sd, color=color.green)
// per-bar window loop over 200 bars (typical "heavy" community script)
float acc = 0.0
for j = 0 to 199
    acc += (high[j] - low[j])
plot(acc / 200, "Avg range 200", display=display.data_window)
