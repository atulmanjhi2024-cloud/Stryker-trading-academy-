//@version=6
indicator("v6 HTF levels + map (sample)", overlay=true)
string tfA = input.timeframe("60", "HTF A")
string tfB = input.timeframe("240", "HTF B")
[oA, hA, lA] = request.security(syminfo.tickerid, tfA, [open, high, low])
[oB, hB, lB] = request.security(syminfo.tickerid, tfB, [open, high, low])
float dOpen = request.security(syminfo.tickerid, "D", open)
var map<string, float> lv = map.new<string, float>()
lv.put("A open", oA)
lv.put("B open", oB)
lv.put("Day open", dOpen)
plot(lv.get("A open"), "HTF A open", color=color.aqua, style=plot.style_stepline)
plot(lv.get("B open"), "HTF B open", color=color.orange, style=plot.style_stepline)
plot(lv.get("Day open"), "Day open", color=color.white, style=plot.style_stepline)
plot(hB, "HTF B high", color=color.new(color.green, 50))
plot(lB, "HTF B low", color=color.new(color.red, 50))
