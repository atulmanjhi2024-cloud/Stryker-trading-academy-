//@version=6
strategy("v6 breakout strategy (sample)", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=5)
int len = input.int(20, "Channel")
float hh = ta.highest(high, len)[1]
float ll = ta.lowest(low, len)[1]
if close > hh and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)
if close < ll and strategy.position_size >= 0
    strategy.entry("Short", strategy.short)
plot(hh, "Upper", color=color.green)
plot(ll, "Lower", color=color.red)
