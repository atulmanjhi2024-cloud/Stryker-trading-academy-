//@version=5
indicator("QT style sample (test)", overlay=true, max_labels_count=200)
e1 = ta.ema(close, 9)
e2 = ta.ema(close, 21)
e3 = ta.ema(close, 50)
e4 = ta.ema(close, 100)
e5 = ta.sma(close, 200)
[bm, bu, bl] = ta.bb(close, 20, 2)
a = ta.atr(14)
plot(e1, "e1", color.new(color.aqua, 0))
plot(e2, "e2", color.new(color.yellow, 0))
plot(e3, "e3", color.new(color.orange, 0))
plot(e4, "e4", color.new(color.red, 0))
plot(e5, "e5", color.new(color.white, 0))
plot(bu, "bu", color.new(color.gray, 50))
plot(bl, "bl", color.new(color.gray, 50))
plot(bm, "bm", color.new(color.gray, 70))
plot(close + a, "up", color.new(color.green, 60))
plot(close - a, "dn", color.new(color.red, 60))
up = ta.crossover(e1, e2)
dn = ta.crossunder(e1, e2)
plotshape(up, "buy", shape.triangleup, location.belowbar, color.green)
plotshape(dn, "sell", shape.triangledown, location.abovebar, color.red)
if up
    label.new(bar_index, low, "B " + str.tostring(close, "#.##"), style=label.style_label_up, color=color.green, textcolor=color.white)
if dn
    label.new(bar_index, high, "S " + str.tostring(close, "#.##"), style=label.style_label_down, color=color.red, textcolor=color.white)
